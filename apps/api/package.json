  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest build && node dist/main.js",
    "start:debug": "nest build && node --inspect dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "start:worker": "nest build && node dist/worker.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@demo/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.2.0",
    "bullmq": "6.3.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "5.8.1",
    "pdfjs-dist": "^5.4.149",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.20.5",
